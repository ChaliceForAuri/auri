{
	"name": "@aurilabs/forms",
	"version": "0.6.0",
	"type": "module",
	"description": "The auri forms catalog for A2UI — agent-composed forms that collect answers from humans. Svelte 5, plugs into svelte-a2ui.",
	"license": "Apache-2.0",
	"author": "Hugo Pretorius <ohheyhugo@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChaliceForAuri/auri.git",
		"directory": "packages/forms"
	},
	"files": [
		"dist",
		"contract",
		"!dist/**/*.test.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme.css": "./dist/theme.css",
		"./contract/catalog.json": "./contract/catalog.json",
		"./contract/prompt.md": "./contract/prompt.md",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "node --test tests/*.test.js",
		"test:browser": "vitest run",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"package": "svelte-package && publint",
		"eval": "node ../ops/scripts/emission-eval.js --pack contract/prompt.md --contract contract/catalog.json --scenarios-file contract/emission-scenarios.json",
		"prepublishOnly": "npm run package"
	},
	"peerDependencies": {
		"svelte": "^5.55.0",
		"svelte-a2ui": "^0.1.0"
	},
	"dependencies": {
		"@aurilabs/core": "^0.6.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"axe-core": "^4.13.0",
		"playwright": "^1.62.1",
		"publint": "^0.3.0",
		"svelte": "^5.55.7",
		"svelte-a2ui": "^0.1.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.6.0",
		"vite": "^6.0.0",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0"
	},
	"homepage": "https://chaliceforauri.github.io/auri/",
	"keywords": [
		"a2ui",
		"generative-ui",
		"genui",
		"agent",
		"llm",
		"svelte",
		"sveltekit",
		"forms",
		"catalog"
	],
	"publishConfig": {
		"access": "public"
	}
}
