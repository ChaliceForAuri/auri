				}
			}
		},
		"skeleton-base": {
			"$value": "oklch(0 0 0 / 0.06)",
			"$description": "The in-between state: component-shaped shimmer while a binding is unresolved.",
			"$extensions": {
				"org.aurilabs": {
					"dark": "oklch(1 0 0 / 0.07)"
				}
			}
		},
		"skeleton-sheen": {
			"$value": "oklch(0 0 0 / 0.025)",
			"$extensions": {
