					"dark": "oklch(1 0 0 / 0.03)"
				}
			}
		}
	},
	"shape": {
		"$type": "dimension",
		"$description": "shadcn-v4-derived, base radius 0.625rem. Radius follows role, never taste-per-component.",
		"sm": {
			"$value": "6px",
			"$description": "Chips, badges, small controls."
		},
		"md": {
			"$value": "10px",
			"$description": "Buttons, inputs, callouts, code insets."
		},
		"lg": {
			"$value": "14px",
			"$description": "Cards."
		},
		"pill": {
			"$value": "999px",
			"$description": "Progress tracks only."
		}
	},
	"motion": {
		"$description": "The hero system. Entrances decelerate, exits accelerate, in-place changes cross-fade.",
		"fast": {
			"$type": "duration",
			"$value": "120ms",
			"$description": "Micro state changes: badge intent flip, delta update."
		},
		"base": {
			"$type": "duration",
			"$value": "240ms",
			"$description": "Component entrance."
		},
		"slow": {
			"$type": "duration",
			"$value": "400ms",
			"$description": "Choreographed sequences."
		},
		"stagger": {
			"$type": "duration",
			"$value": "40ms",
			"$description": "Per-sibling delay as a stream batch paints; capped at 8."
		},
		"ease-out": {
			"$type": "cubicBezier",
			"$value": [0.22, 1, 0.36, 1],
			"$extensions": {
				"org.aurilabs": {
					"cssName": "--auri-ease-out"
				}
			}
		},
		"ease-in": {
			"$type": "cubicBezier",
			"$value": [0.55, 0, 1, 0.45],
			"$extensions": {
				"org.aurilabs": {
					"cssName": "--auri-ease-in"
				}
			}
		}
	},
	"type": {
		"$description": "auri has a type SCALE, not a typeface \u2014 components inherit the host font. Three roles: value, label, caption.",
		"value-size": {
			"$type": "dimension",
			"$value": "1.75rem"
		},
		"value-weight": {
			"$type": "fontWeight",
			"$value": 600
		},
		"label-size": {
			"$type": "dimension",
			"$value": "0.8125rem"
		},
		"label-weight": {
			"$type": "fontWeight",
			"$value": 500
		},
		"caption-size": {
			"$type": "dimension",
			"$value": "0.75rem"
		}
	}
}
