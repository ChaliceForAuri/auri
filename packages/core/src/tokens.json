{
	"$schema": "https://tr.designtokens.org/format/",
	"$description": "auri design tokens \u2014 the neutral source of truth (DTCG format). tokens.css is GENERATED from this file by scripts/build-tokens.js; never edit the CSS by hand. Ground values adopted verbatim from shadcn/ui v4 (MIT). Three value kinds appear here: literals, aliases ({group.token}), and mix recipes carried in $extensions \u2014 a recipe stays an OPERATION rather than a flattened color so every target keeps the two-seed reseeding API (CSS emits runtime color-mix(); Dart emits a mix call in the generated theme).",
	"$extensions": {
		"org.aurilabs": {
			"cssPrefix": "auri",
			"modes": ["light", "dark"],
			"note": "A token's $value is its LIGHT value. Dark lives in $extensions['org.aurilabs'].dark. DTCG-naive tooling therefore reads a correct light theme with no special support."
		}
	},
	"color": {
		"$type": "color",
		"$description": "Color is rare: one brand accent for primary actions and focus, five intents as colored text on soft tints. Content is the color everywhere else.",
		"seed": {
			"$value": "#047857",
			"$description": "The brand accent for LIGHT surfaces (Tailwind emerald-700). Half of the reseeding API \u2014 override this and every primary tone follows.",
			"$extensions": {
				"org.aurilabs": {
					"role": "reseed-api"
				}
			}
		},
		"seed-dark": {
			"$value": "#34d399",
			"$description": "The brand accent for DARK surfaces (Tailwind emerald-400). Accents need different weights per theme to hold contrast.",
			"$extensions": {
				"org.aurilabs": {
					"role": "reseed-api"
				}
			}
		},
		"surface": {
			"$value": "oklch(1 0 0)",
			"$description": "The page ground.",
			"$extensions": {
				"org.aurilabs": {
					"dark": "oklch(0.145 0 0)"
				}
			}
		},
		"surface-container": {
			"$value": "oklch(1 0 0)",
			"$description": "Cards: white plus a hairline in light; a lifted tone in dark.",
			"$extensions": {
				"org.aurilabs": {
					"dark": "oklch(0.205 0 0)"
				}
			}
		},
		"surface-container-high": {
			"$value": "oklch(0.97 0 0)",
			"$description": "Muted fill \u2014 code insets, chips, hover grounds.",
			"$extensions": {
				"org.aurilabs": {
					"dark": "oklch(0.269 0 0)"
				}
			}
		},
		"on-surface": {
			"$value": "oklch(0.145 0 0)",
			"$description": "Primary text.",
			"$extensions": {
				"org.aurilabs": {
					"dark": "oklch(0.985 0 0)"
				}
			}
		},
		"on-surface-variant": {
			"$value": "oklch(0.556 0 0)",
			"$description": "Labels, captions, muted text.",
			"$extensions": {
				"org.aurilabs": {
					"dark": "oklch(0.708 0 0)"
				}
			}
		},
		"outline-variant": {
			"$value": "oklch(0.922 0 0)",
			"$description": "The hairline. White-alpha in dark: depth from layered transparency, never tone.",
			"$extensions": {
				"org.aurilabs": {
					"dark": "oklch(1 0 0 / 10%)",
					"contrastMore": {
						"light": "oklch(0.5 0 0)",
						"dark": "oklch(1 0 0 / 0.35)"
					}
				}
			}
		},
		"input-fill": {
			"$value": "transparent",
			"$description": "Light inputs are a hairline with no fill; dark inputs take a translucent white wash.",
			"$extensions": {
				"org.aurilabs": {
					"dark": "oklch(1 0 0 / 8%)"
				}
			}
		},
		"primary": {
			"$value": "{color.seed}",
			"$description": "Primary actions, links, focus rings.",
			"$extensions": {
				"org.aurilabs": {
					"dark": "{color.seed-dark}"
				}
			}
		},
		"on-primary": {
			"$value": "#ffffff",
			"$extensions": {
				"org.aurilabs": {
					"dark": "oklch(0.145 0 0)"
				}
			}
		},
		"primary-container": {
			"$value": "{color.seed}",
			"$description": "Soft tint of the accent. A MIX RECIPE, not a literal \u2014 this is what keeps reseeding live on every platform.",
			"$extensions": {
				"org.aurilabs": {
					"mix": {
						"amount": 10,
						"with": "white",
						"space": "oklab"
					},
					"dark": "{color.seed-dark}",
					"darkMix": {
						"amount": 16,
						"with": "transparent",
						"space": "oklab"
					}
				}
			}
		},
		"on-primary-container": {
			"$value": "{color.seed}",
			"$extensions": {
				"org.aurilabs": {
					"dark": "{color.seed-dark}",
					"darkMix": {
						"amount": 55,
						"with": "white",
						"space": "oklab"
					}
				}
			}
		},
		"intent-good": {
			"$value": "#047857",
			"$description": "Healthy, succeeding, positive.",
			"$extensions": {
				"org.aurilabs": {
					"dark": "#34d399",
					"forcedColors": "CanvasText"
				}
			}
		},
		"intent-good-container": {
			"$value": "#047857",
			"$extensions": {
				"org.aurilabs": {
					"mix": {
						"amount": 9,
						"with": "white",
						"space": "oklab"
					},
					"dark": "#34d399",
					"darkMix": {
						"amount": 14,
						"with": "transparent",
						"space": "oklab"
					}
				}
			}
		},
		"on-intent-good-container": {
			"$value": "#047857",
			"$extensions": {
				"org.aurilabs": {
					"dark": "#6ee7b7"
				}
			}
		},
		"intent-bad": {
			"$value": "#dc2626",
			"$description": "Failing, dangerous, critical.",
			"$extensions": {
				"org.aurilabs": {
					"dark": "#f87171",
					"forcedColors": "CanvasText"
				}
			}
		},
		"intent-bad-container": {
			"$value": "#dc2626",
			"$extensions": {
				"org.aurilabs": {
					"mix": {
						"amount": 9,
						"with": "white",
						"space": "oklab"
					},
					"dark": "#f87171",
					"darkMix": {
						"amount": 14,
						"with": "transparent",
						"space": "oklab"
					}
				}
			}
		},
		"on-intent-bad-container": {
			"$value": "#b91c1c",
			"$extensions": {
				"org.aurilabs": {
					"dark": "#fca5a5"
				}
			}
		},
		"intent-warning": {
			"$value": "#b45309",
			"$description": "Needs attention, degraded, in flight.",
			"$extensions": {
				"org.aurilabs": {
					"dark": "#fbbf24",
					"forcedColors": "CanvasText"
				}
			}
		},
		"intent-warning-container": {
			"$value": "#d97706",
			"$extensions": {
				"org.aurilabs": {
					"mix": {
						"amount": 11,
						"with": "white",
						"space": "oklab"
					},
					"dark": "#fbbf24",
					"darkMix": {
						"amount": 13,
						"with": "transparent",
						"space": "oklab"
					}
				}
			}
		},
		"on-intent-warning-container": {
			"$value": "#92400e",
			"$extensions": {
				"org.aurilabs": {
					"dark": "#fcd34d"
				}
			}
		},
		"intent-info": {
			"$value": "#0369a1",
			"$description": "Informational emphasis, no judgment.",
			"$extensions": {
				"org.aurilabs": {
					"dark": "#38bdf8",
					"forcedColors": "CanvasText"
				}
			}
		},
		"intent-info-container": {
			"$value": "#0284c7",
			"$extensions": {
				"org.aurilabs": {
					"mix": {
						"amount": 9,
						"with": "white",
						"space": "oklab"
					},
					"dark": "#38bdf8",
					"darkMix": {
						"amount": 14,
						"with": "transparent",
						"space": "oklab"
					}
				}
			}
		},
		"on-intent-info-container": {
			"$value": "#0369a1",
			"$extensions": {
				"org.aurilabs": {
					"dark": "#7dd3fc"
				}
			}
		},
		"intent-neutral": {
			"$value": "oklch(0.556 0 0)",
			"$description": "No semantic claim \u2014 the resting state.",
			"$extensions": {
				"org.aurilabs": {
					"dark": "oklch(0.708 0 0)",
					"forcedColors": "CanvasText"
				}
			}
		},
		"intent-neutral-container": {
			"$value": "oklch(0.97 0 0)",
			"$extensions": {
				"org.aurilabs": {
					"dark": "oklch(1 0 0 / 8%)"
				}
			}
		},
		"on-intent-neutral-container": {
			"$value": "oklch(0.371 0 0)",
			"$extensions": {
				"org.aurilabs": {
					"dark": "oklch(0.85 0 0)"
				}
			}
		},
		"state-hover": {
			"$value": "currentColor",
			"$description": "State layers ride on the element's own color \u2014 a mix recipe against the current text color.",
			"$extensions": {
				"org.aurilabs": {
					"mix": {
						"amount": 6,
						"with": "transparent",
						"space": "oklab"
					}
				}
			}
		},
		"state-press": {
			"$value": "currentColor",
			"$extensions": {
