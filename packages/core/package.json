{
	"name": "@aurilabs/core",
	"version": "0.7.0",
	"type": "module",
	"description": "Shared foundations for auri catalogs: design tokens (intent scale, motion, type roles, chart ramp) for the A2UI component ecosystem.",
	"license": "Apache-2.0",
	"author": "Hugo Pretorius <ohheyhugo@gmail.com>",
	"keywords": [
		"a2ui",
		"design-tokens",
		"generative-ui",
		"agent",
		"svelte"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChaliceForAuri/auri.git",
		"directory": "packages/core"
	},
	"homepage": "https://chaliceforauri.github.io/auri/",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src"
	],
	"exports": {
		"./tokens.css": "./src/tokens.css",
		"./compose": {
			"types": "./src/compose.d.ts",
			"default": "./src/compose.js"
		},
		"./package.json": "./package.json",
		"./tokens.json": "./src/tokens.json",
		"./conformance": {
			"types": "./src/conformance.d.ts",
			"default": "./src/conformance.js"
		}
	},
	"scripts": {
		"build:tokens": "node scripts/build-tokens.js",
		"check:tokens": "node scripts/build-tokens.js --check",
		"test": "node --test tests/*.test.js"
	}
}
